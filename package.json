{
  "name": "storyloom",
  "productName": "Storyloom",
  "version": "0.6.1",
  "private": true,
  "description": "Make picture books on your Mac, with optional AI help for writing, pictures, and narration",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/g-baskin/gaga.git"
  },
  "homepage": "https://github.com/g-baskin/gaga",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint .",
    "test": "node --test test/*.test.cjs",
    "test:live": "node --env-file-if-exists=.env.local --env-file-if-exists=../.env.local --test test/live/*.live.cjs",
    "self-test": "electron . --self-test",
    "package": "node package.mjs",
    "dist": "node dist.mjs",
    "release": "node scripts/changelog.mjs release"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@eslint/js": "10.0.1",
    "electron": "44.7.0",
    "eslint": "10.12.0",
    "globals": "17.13.0"
  }
}
